+//
+// The master_center layout: quarter | centred half | quarter, the fixed
+// column widths never changing with window count. The bsp tree is kept
+// as-is and used ONLY as an ordered container — splits and ratios are
+// ignored, and every occupied leaf is assigned its frame directly, in
+// leaf order: the first count/2 leaves stack in the left column, the
+// next is the centre, the rest stack in the right column. One window
+// gets the centred half with both quarters empty; two get the left
+// quarter and the centre with the right quarter empty. A leaf may hold
+// a window stack; it occupies a single slot.
+//
+// Internal node areas are deliberately NOT maintained; anything that
+// consumes them (zoom-parent, mouse bsp-grid adjust, --ratio) is guarded
+// off for this layout in window_manager.c.
+//
+static void view_master_center_column(struct window_node **leaves, int first, int count, float x, float w, float y, float h, int gap)
+{
+    float wh = (h - (count - 1) * gap) / count;
+    for (int i = 0; i < count; ++i) {
+        leaves[first+i]->area = (struct area) { x, y + i * (wh + gap), w, wh };
+    }
+}
+
+static void view_master_center_update(struct view *view)
+{
+    struct window_node **leaves = NULL;
+    for (struct window_node *node = window_node_find_first_leaf(view->root); node; node = window_node_find_next_leaf(node)) {
+        if (window_node_is_occupied(node)) ts_buf_push(leaves, node);
+    }
+
+    int count = leaves ? ts_buf_len(leaves) : 0;
+    if (!count) return;
+
+    int gap = window_node_get_gap(view);
+    struct area bounds = view->root->area;
+
+    float avail  = bounds.w - 2 * gap;
+    float center = avail * g_space_manager.center_ratio;
+    float side   = (avail - center) * 0.5f;
+    float center_x = bounds.x + side + gap;
+
+    if (count == 1) {
+        leaves[0]->area = (struct area) { center_x, bounds.y, center, bounds.h };
+    } else if (count == 2) {
+        leaves[0]->area = (struct area) { bounds.x, bounds.y, side, bounds.h };
+        leaves[1]->area = (struct area) { center_x, bounds.y, center, bounds.h };
+    } else {
+        int nl = count / 2;
+        int nr = count - 1 - nl;
+
+        float right_x = center_x + center + gap;
+        float right_w = bounds.x + bounds.w - right_x;
+
+        view_master_center_column(leaves, 0, nl, bounds.x, side, bounds.y, bounds.h, gap);
+        leaves[nl]->area = (struct area) { center_x, bounds.y, center, bounds.h };
+        view_master_center_column(leaves, nl + 1, nr, right_x, right_w, bounds.y, bounds.h, gap);
+    }
+
+    for (int i = 0; i < count; ++i) {
+        if (leaves[i]->insert_dir) insert_feedback_show(leaves[i]);
+    }
+}
+
 struct window_node *view_add_window_node_with_insertion_point(struct view *view, struct window *window, uint32_t insertion_point)
 {
     if (!window_node_is_occupied(view->root) &&
@@ -755,8 +823,11 @@ struct window_node *view_add_window_node_with_insertion_point(struct view *view,
