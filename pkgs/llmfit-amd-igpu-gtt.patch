+/// Effective *read* streaming bandwidth in GB/s, measured once per process and
+/// cached. Companion to [`measured_ram_bandwidth_gbps`], which uses a memcpy
+/// (STREAM-copy convention: bytes read + bytes written).
+///
+/// Decode streams weights: every token reads the full weight set once and
+/// writes almost nothing. A copy loop is the wrong shape for that, and it also
+/// pays read-for-ownership traffic the byte count never sees, so it lands ~15%
+/// below a pure read on the same machine. Measured on a Ryzen AI 7 PRO 350
+/// (AC, performance profile): memcpy 34.4 GB/s, read 39.3 GB/s, and real
+/// llama.cpp Vulkan decode achieves 41.7 GB/s.
+///
+/// Kept separate rather than replacing the memcpy probe, because the
+/// MoE-offload path is calibrated against that one.
+pub fn measured_read_bandwidth_gbps() -> Option<f64> {
+    static MEASURED: std::sync::OnceLock<Option<f64>> = std::sync::OnceLock::new();
+    *MEASURED.get_or_init(measure_read_bandwidth_gbps)
+}
+
+fn measure_read_bandwidth_gbps() -> Option<f64> {
+    use std::time::{Duration, Instant};
+
+    // 64 MiB per thread is comfortably past a 16-32 MB L3, so this measures
+    // DRAM. Four independent accumulators keep the adds off the critical path
+    // so the loop stays memory-bound rather than latency-bound.
+    const BUF_WORDS: usize = 8 * 1024 * 1024; // 64 MiB of u64
+    const MEASURE_WINDOW: Duration = Duration::from_millis(120);
+
+    let threads = std::thread::available_parallelism()
+        .map(|n| n.get().min(8))
+        .unwrap_or(4);
+
+    let barrier = std::sync::Barrier::new(threads);
+    let per_thread_gbps: Vec<f64> = std::thread::scope(|scope| {
+        let barrier = &barrier;
+        let handles: Vec<_> = (0..threads)
+            .map(|_| {
+                scope.spawn(move || {
+                    let buf = vec![1u64; BUF_WORDS];
+                    // Warmup pass faults pages in before the timed window.
+                    let mut acc = 0u64;
+                    for w in &buf {
+                        acc = acc.wrapping_add(*w);
+                    }
+                    std::hint::black_box(acc);
+                    barrier.wait();
+                    let start = Instant::now();
+                    let mut passes = 0u64;
+                    while start.elapsed() < MEASURE_WINDOW {
+                        let (mut a, mut b, mut c, mut d) = (0u64, 0u64, 0u64, 0u64);
+                        for chunk in buf.chunks_exact(4) {
+                            a = a.wrapping_add(chunk[0]);
+                            b = b.wrapping_add(chunk[1]);
+                            c = c.wrapping_add(chunk[2]);
+                            d = d.wrapping_add(chunk[3]);
+                        }
+                        std::hint::black_box(a ^ b ^ c ^ d);
+                        passes += 1;
+                    }
+                    let secs = start.elapsed().as_secs_f64();
+                    (passes as f64) * (BUF_WORDS * 8) as f64 / secs / 1e9
+                })
+            })
+            .collect();
+        handles.into_iter().filter_map(|h| h.join().ok()).collect()
+    });
+
+    if per_thread_gbps.len() != threads {
+        return None;
+    }
+    let total: f64 = per_thread_gbps.iter().sum();
+    (2.0..=4000.0).contains(&total).then_some(total)
+}
